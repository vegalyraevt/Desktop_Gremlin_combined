<Window x:Class="Desktop_Gremlin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Gremlin Settings" 
        Height="580" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MinHeight="400" MinWidth="350"
        Background="#2D2D30">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Dance Settings -->
            <GroupBox Grid.Row="0" Header="🎵 Dance Settings">
                <StackPanel Margin="5">
                    <CheckBox x:Name="chkAutoDance" Content="Enable auto-dance when music detected"/>
                    <CheckBox x:Name="chkAutoStop" Content="Auto-stop dance after cycle"/>
                    <CheckBox x:Name="chkMusicNotes" Content="Show music notes while dancing"/>
                    
                    <Separator Margin="0,8,0,8" Background="#555"/>
                    
                    <CheckBox x:Name="chkDynamicChance" Content="Dynamic chance (increases on fail)"/>
                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="20,0,0,5"
                               Text="Each failed roll increases chance until it triggers"/>
                    
                    <Label Content="Dance trigger chance:" Margin="0,5,0,0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="sliderDanceChance" Minimum="0" Maximum="100" Value="30" 
                                TickFrequency="10" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="1" Foreground="White" VerticalAlignment="Center"
                                   Text="{Binding ElementName=sliderDanceChance, Path=Value, StringFormat={}{0:0}%}"/>
                    </Grid>
                    
                    <Label Content="Dance chance increase per fail:"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="sliderDanceIncrement" Minimum="1" Maximum="25" Value="10"
                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="1" Foreground="White" VerticalAlignment="Center"
                                   Text="{Binding ElementName=sliderDanceIncrement, Path=Value, StringFormat=+{0:0}%}"/>
                    </Grid>
                    
                    <Label Content="Auto-stop chance per cycle:"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="sliderStopChance" Minimum="0" Maximum="100" Value="40"
                                TickFrequency="10" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="1" Foreground="White" VerticalAlignment="Center"
                                   Text="{Binding ElementName=sliderStopChance, Path=Value, StringFormat={}{0:0}%}"/>
                    </Grid>
                    
                    <Label Content="Stop chance increase per cycle:"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="sliderStopIncrement" Minimum="1" Maximum="25" Value="10"
                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="1" Foreground="White" VerticalAlignment="Center"
                                   Text="{Binding ElementName=sliderStopIncrement, Path=Value, StringFormat=+{0:0}%}"/>
                    </Grid>
                    
                    <Separator Margin="0,8,0,8" Background="#555"/>
                    
                    <Label Content="Dance check interval (seconds):"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="sliderDanceCheckInterval" Minimum="1" Maximum="30" Value="5"
                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="1" Foreground="White" VerticalAlignment="Center"
                                   Text="{Binding ElementName=sliderDanceCheckInterval, Path=Value, StringFormat={}{0:0}s}"/>
                    </Grid>
                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="5,0,0,5"
                               Text="How often to roll for dance while music plays"/>
                    
                    <Label Content="Dance cooldown after trigger (seconds):"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="sliderDanceCooldown" Minimum="5" Maximum="60" Value="15"
                                TickFrequency="5" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="1" Foreground="White" VerticalAlignment="Center"
                                   Text="{Binding ElementName=sliderDanceCooldown, Path=Value, StringFormat={}{0:0}s}"/>
                    </Grid>
                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="5,0,0,5"
                               Text="Minimum time between dance triggers"/>
                               
                    <Separator Margin="0,8,0,8" Background="#555"/>
                    
                    <CheckBox x:Name="chkUmaEasterEgg" Content="🎠 Something silly for Umas~" IsChecked="True"/>
                    <TextBlock Foreground="Gray" FontSize="10" FontStyle="Italic" TextWrapping="Wrap" Margin="20,0,0,5"
                               Text="A special surprise... you'll know it when you see it! ✨"/>
                </StackPanel>
            </GroupBox>
            
            <!-- Audio Detection Settings -->
            <GroupBox Grid.Row="1" Header="🎧 Music Detection">
                <StackPanel Margin="5">
                    <CheckBox x:Name="chkUseMediaSession" Content="Use Windows Media Session (more accurate)"/>
                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="20,0,0,5"
                               Text="Detects actual media playback (Spotify, browsers, etc.)"/>
                    
                    <CheckBox x:Name="chkUseVolumeDetection" Content="Use volume-based detection (fallback)"/>
                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="20,0,0,5"
                               Text="Triggers on any system audio above threshold"/>
                    
                    <Label Content="Volume detection threshold:" Margin="0,5,0,0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="sliderAudioThreshold" Minimum="1" Maximum="50" Value="5"
                                TickFrequency="5" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="1" Foreground="White" VerticalAlignment="Center"
                                   Text="{Binding ElementName=sliderAudioThreshold, Path=Value, StringFormat={}{0:0}%}"/>
                    </Grid>
                    
                    <Label Content="Audio sensitivity multiplier:" Margin="0,5,0,0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="sliderAudioSensitivity" Minimum="0.1" Maximum="5" Value="1"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="1" Foreground="White" VerticalAlignment="Center"
                                   Text="{Binding ElementName=sliderAudioSensitivity, Path=Value, StringFormat=x{0:0.0}}"/>
                    </Grid>
                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="5,0,0,0"
                               Text="Adjust sensitivity: &lt;1 = less sensitive, &gt;1 = more sensitive. Check Debug View to tune."/>
                </StackPanel>
            </GroupBox>
            
            <!-- Sound Volume -->
            <GroupBox Grid.Row="2" Header="🔊 Sound Volume">
                <StackPanel Margin="5">
                    <Label Content="Character voice/sound volume:"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="sliderVolume" Minimum="0" Maximum="100" Value="100"
                                TickFrequency="10" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="1" Foreground="White" VerticalAlignment="Center"
                                   Text="{Binding ElementName=sliderVolume, Path=Value, StringFormat={}{0:0}%}"/>
                    </Grid>
                </StackPanel>
            </GroupBox>
            
            <!-- Behavior Settings -->
            <GroupBox Grid.Row="3" Header="⚙️ Behavior Settings">
                <StackPanel Margin="5">
                    <CheckBox x:Name="chkAllowRandomness" Content="Allow random actions"/>
                    <CheckBox x:Name="chkFollowCursor" Content="Follow cursor when clicked"/>
                    
                    <Label Content="Random action interval (seconds):"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtMinInterval" Width="40" Text="3" Background="#3E3E42" 
                                 Foreground="White" BorderBrush="#555"/>
                        <Label Grid.Column="1" Content=" to " VerticalAlignment="Center"/>
                        <TextBox x:Name="txtMaxInterval" Width="40" Text="10" Background="#3E3E42"
                                 Foreground="White" BorderBrush="#555"/>
                    </Grid>
                </StackPanel>
            </GroupBox>
            
            <!-- Companion Settings -->
            <GroupBox Grid.Row="4" Header="👥 Companion Settings">
                <StackPanel Margin="5">
                    <CheckBox x:Name="chkEnableCompanion" Content="Enable companion spawning"/>
                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="20,0,0,5"
                               Text="Click character's head to spawn companion (if supported)"/>
                </StackPanel>
            </GroupBox>
            
            <!-- Buttons -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="btnSave" Content="Save" Width="80" Height="28" Margin="5"
                        Background="#0E639C" Foreground="White" BorderBrush="#0E639C"
                        Click="BtnSave_Click"/>
                <Button x:Name="btnCancel" Content="Cancel" Width="80" Height="28" Margin="5"
                        Background="#3E3E42" Foreground="White" BorderBrush="#555"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
